# Copia este archivo a .env.local y rellena los valores reales.
# Las variables NEXT_PUBLIC_* son visibles en el navegador.

# ─── Tienda (públicas) ───
NEXT_PUBLIC_SITE_NAME="La Camiseta"
NEXT_PUBLIC_SITE_DESCRIPTION="Camisetas de fútbol de clubes y selecciones de todas las épocas."
NEXT_PUBLIC_SITE_ESLOGAN="Viste tu historia."
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

# ─── URL base del sitio (sin barra final) ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── WhatsApp — Pedidos (sin +, sin espacios) ───
NEXT_PUBLIC_WHATSAPP_ORDER="5358080925"

# ─── Tienda física ───
NEXT_PUBLIC_PICKUP_ADDRESS="Zanja #37/ Aguila y Galiano, Centro Habana, Cuba"
NEXT_PUBLIC_PICKUP_COORDS="23.133982, -82.362472"

# ─── Hosting / Dev ───
NEXT_PUBLIC_HOSTING="https://lacamiseta.netlify.app"
NEXT_PUBLIC_DEV_ORIGIN=""